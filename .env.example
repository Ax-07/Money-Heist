# Aucun secret ne doit être commité dans ce fichier.
MONEY_HEIST_APP_ENV=development
MONEY_HEIST_RUNTIME_MODE=PAPER
MONEY_HEIST_LOG_LEVEL=INFO
MONEY_HEIST_DATABASE_URL=sqlite:///./data/money_heist.db
MONEY_HEIST_API_HOST=127.0.0.1
MONEY_HEIST_API_PORT=8000
MONEY_HEIST_DEFAULT_SYSTEM_ID=balanced_v1

# Batch 15 — éligibilité LIVE. Les valeurs par défaut restent fail-closed.
# Ces variables ne constituent PAS une autorisation opérateur et ne peuvent pas armer le LIVE.
MONEY_HEIST_LIVE_ENVIRONMENT=disabled
MONEY_HEIST_LIVE_SYSTEM_ID=

# Les valeurs Risk Balanced restent volontairement non définies dans le dépôt.
# Pointer vers un fichier local explicite seulement après validation des limites existantes.
MONEY_HEIST_LIVE_RISK_PROFILE_FILE=

# Batch 13 n'a volontairement pas figé ces paramètres Market Data.
# Le preflight reste BLOCKED tant qu'ils ne sont pas définis explicitement.
MONEY_HEIST_LIVE_MARKET_MAX_AGE_SECONDS=
MONEY_HEIST_LIVE_METADATA_MAX_AGE_SECONDS=
MONEY_HEIST_LIVE_TIMEFRAMES=

# Credentials Kraken — noms uniquement. Ne jamais placer de vraies valeurs dans ce fichier.
# Leur présence NE PEUT PAS activer/ armer le LIVE.
MONEY_HEIST_KRAKEN_API_KEY=
MONEY_HEIST_KRAKEN_API_SECRET=

# Tests privés READ-ONLY seulement, explicitement opt-in.
MONEY_HEIST_RUN_KRAKEN_PRIVATE_TESTS=0
